{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "rrze-designsystem/token-table",
  "version": "1.0.0",
  "title": "Token Table",
  "category": "rrze-designsystem",
  "description": "Displays design tokens from the RRZE Design System.",
  "keywords": [
    "design system",
    "token",
    "style guide"
  ],
  "attributes": {
    "tokenType": {
      "type": "string",
      "default": "color"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "heading": {
      "type": "string",
      "default": "Colors"
    },
    "showHeading": {
      "type": "boolean",
      "default": true
    },
    "headingLevel": {
      "type": "number",
      "default": 2
    },
    "showCopy": {
      "type": "boolean",
      "default": true
    },
    "compact": {
      "type": "boolean",
      "default": false
    }
  },
  "supports": {
    "align": [
      "wide",
      "full"
    ],
    "anchor": true,
    "html": false,
    "spacing": {
      "margin": true,
      "padding": true
    }
  },
  "textdomain": "rrze-designsystem",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css"
}